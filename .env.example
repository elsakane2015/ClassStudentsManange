APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=


MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: allow teachers to connect Outlook/Hotmail through Microsoft OAuth.
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_REDIRECT_URI="${APP_URL}/api/teacher-email/microsoft/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional: Native Mobile Push Notifications (iOS APNs Relay/Direct & Android FCM/Webhook)
# Leave credentials empty to gracefully degrade to in-app notifications only.
MOBILE_PUSH_ENABLED=true
APNS_ENABLED=false
# Recommended for multi-school self-hosted deployments: point to centralized APNs relay
APNS_RELAY_URL=
APNS_RELAY_TOKEN=
# Optional direct APNs mode (leave empty when using APNS_RELAY_URL)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.litotime.smartcampus
APNS_PRIVATE_KEY_PATH=
APNS_SANDBOX=true

FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
ANDROID_PUSH_WEBHOOK_URL=
ANDROID_PUSH_WEBHOOK_SECRET=
